/**
 * @file Firebase Security Rules for Firestore (Prototyping Mode)
 *
 * @corePhilosophy This ruleset prioritizes authorization and access control,
 *   while relaxing data validation to facilitate rapid prototyping. It enforces
 *   strict ownership and role-based access where appropriate.
 *
 * @dataStructure
 *   - `/bookings/{bookingId}`: Stores booking requests.
 *   - `/services/{serviceId}`: Stores service details.
 *   - `/users/{userId}/appointments/{appointmentId}`: Stores user-specific appointment data.
 *   - `/suggestedStyles/{suggestedStyleId}`: Stores AI-generated style suggestions.
 *
 * @keySecurityDecisions
 *   - Public read access is granted to `/services` and `/suggestedStyles` for open discovery.
 *   - Bookings can be created by anyone, reflecting an open booking request system.
 *   - User-specific appointment data is strictly controlled via path-based ownership.
 *   - The `list` operation is allowed only for the owner in user-scoped subcollections to read own data.
 *   - No schema validation is performed beyond requiring an owner field for ownership checks.
 *
 * @denormalizationForAuthorization N/A
 * @structuralSegregation N/A
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to create booking requests, but restricts updates and deletes to authorized users.
     * @path /bookings/{bookingId}
     * @allow (create) Any unauthenticated user can create booking with a receipt and basic information.
     * @deny (update) An unauthenticated user can not update a booking.
     * @deny (delete) An unauthenticated user can not delete a booking.
     * @principle Allows public creation of booking requests but no schema validation.
     */
    match /bookings/{bookingId} {
      allow get, list: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    /**
     * @description Allows public read access to service details, but restricts writes.
     * @path /services/{serviceId}
     * @allow (get, list) Any unauthenticated user can read services details
     * @deny (create, update, delete) An unauthenticated user can not create, update, delete service details.
     * @principle Allows public read access to service information with no schema validation.
     */
    match /services/{serviceId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows owner-only access to appointments for a specific user, enforced by path-based ownership.
     * @path /users/{userId}/appointments/{appointmentId}
     * @allow (create) Only the user that matches the user id can create.
     * @allow (get, list, update, delete) Only the user that matches the user id can read, write.
     * @deny (create, get, list, update, delete) Other users can not create, read, write.
     * @principle Enforces strict owner-only access to user-specific data, no schema validation performed.
     */
    match /users/{userId}/appointments/{appointmentId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && resource != null;
      allow delete: if isOwner(userId) && resource != null;
    }

    /**
     * @description Allows public read access to suggested styles, but restricts writes.
     * @path /suggestedStyles/{suggestedStyleId}
     * @allow (get, list) Any unauthenticated user can read suggested styles.
     * @deny (create, update, delete) Other users can not create, read, write.
     * @principle Allows public read access to AI-generated style suggestions with no schema validation.
     */
    match /suggestedStyles/{suggestedStyleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Helper function to determine if the current user is the owner of the resource.
     * @param {string} userId The user ID to check against the authenticated user's ID.
     * @returns {boolean} True if the user is signed in and the provided userId matches the authenticated user's ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Helper function to determine if the user is signed in.
     * @returns {boolean} True if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }
  }
}