/**
 * @fileoverview Firestore Security Rules for Braiding Salon App - Prototyping Mode
 *
 * Core Philosophy:
 * This ruleset prioritizes authorization and relational integrity while relaxing schema validation
 * to enable rapid prototyping.  It enforces strict ownership and role-based access control where specified.
 * Schema validation will be added in later iterations.
 *
 * Data Structure:
 * - /bookings/{bookingId}: Stores booking requests.
 * - /services/{serviceId}: Stores service details.
 * - /users/{userId}/appointments/{appointmentId}: Stores appointment details for a specific user.
 * - /suggestedStyles/{suggestedStyleId}: Stores suggested braid styles.
 *
 * Key Security Decisions:
 * - All write operations require authentication.
 * - User-specific data (appointments) is secured via path-based ownership.
 * - Public read access granted where explicitly specified (e.g., /services, /suggestedStyles, /bookings).
 * - Owner-only writes are enforced by comparing request.auth.uid to the document's ownerId (or equivalent).
 * - List operations are generally restricted to owners for user-specific data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows reading bookings for availability checks and creating new bookings, but restricts updates and deletes to authorized users/roles.
     * @path /bookings/{bookingId}
     * @allow (get, list) - Any user can read bookings.
     * @allow (create) - Any authenticated user can create a booking.
     * @deny (update, delete) - Only authenticated users can update/delete a booking.  Authorization to update/delete should be added in the next iteration
     * @principle Allows public read access for availability checks and restricts modifications.
     */
    match /bookings/{bookingId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false; // TODO: Add authorization logic for updates/deletes (e.g., admin role, booking owner)
    }

    /**
     * @description Allows public read access to service details. Write access is denied, should be controlled via backend.
     * @path /services/{serviceId}
     * @allow (get, list) - Any user can read service details.
     * @deny (create, update, delete) - No one can create, update, or delete services via the client.
     * @principle Public read access with restricted write access.
     */
    match /services/{serviceId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows an authenticated user to manage their own appointments.
     * @path /users/{userId}/appointments/{appointmentId}
     * @allow (get, list, create, update, delete) - Only the owner (matching userId) can manage their appointments.
     * @deny (get, list, create, update, delete) - Another user attempts to access appointments under a different userId.
     * @principle Enforces document ownership for user-specific data.
     */
    match /users/{userId}/appointments/{appointmentId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.serviceId is string;
      allow update: if isExistingOwner(userId) && request.resource.data.serviceId is string;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to suggested braid styles. Write access is denied, should be controlled via backend.
     * @path /suggestedStyles/{suggestedStyleId}
     * @allow (get, list) - Any user can read suggested styles.
     * @deny (create, update, delete) - No one can create, update, or delete suggested styles via the client.
     * @principle Public read access with restricted write access.
     */
    match /suggestedStyles/{suggestedStyleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}