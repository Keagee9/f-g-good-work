/**
 * @description This ruleset enforces a public-read, restricted-write model for bookings,
 *              user-ownership for appointments, and open read access for services and suggested styles.
 * @dataStructure
 *  - /bookings/{bookingId}: Stores booking requests with public read access.
 *  - /services/{serviceId}: Stores service details with open read.
 *  - /users/{userId}/appointments/{appointmentId}: Stores user-specific appointments with owner-only access.
 *  - /suggestedStyles/{suggestedStyleId}: Stores suggested styles with open read.
 * @keySecurityDecisions
 *  - Bookings are publicly readable to facilitate date/time availability checks, but creation is open for prototyping.
 *  - User listing is disallowed.
 *  - Ambiguous relationships default to owner-only access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read bookings for availability checks, but only allows create operations.
     *              Does NOT implement any write restrictions.
     * @path /bookings/{bookingId}
     * @allow (get, list): Any user can read booking information.
     * @allow (create): Any user can create a booking.
     * @deny (update, delete): No user can update or delete a booking.
     * @principle Allows public read access for checking booking availability; open create for prototyping.
     */
    match /bookings/{bookingId} {
      allow get: if true;
      allow list: if true;
      allow create: if true;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Allows anyone to read service details.
     * @path /services/{serviceId}
     * @allow (get, list): Any user can read service details.
     * @deny (create, update, delete): No user can create, update, or delete a service.
     * @principle Allows open read access to service details.
     */
    match /services/{serviceId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Enforces user-ownership for appointments.
     * @path /users/{userId}/appointments/{appointmentId}
     * @allow (get, list): Only the owner can read their appointments.
     * @allow (create): Only the owner can create appointments under their user ID.
     * @allow (update, delete): Only the owner can update or delete their appointments, if they exist.
     * @principle Enforces user-ownership for appointment data.
     */
    match /users/{userId}/appointments/{appointmentId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Allows anyone to read suggested braid styles.
     * @path /suggestedStyles/{suggestedStyleId}
     * @allow (get, list): Any user can read suggested styles.
     * @deny (create, update, delete): No user can create, update, or delete a suggested style.
     * @principle Allows open read access to suggested styles.
     */
    match /suggestedStyles/{suggestedStyleId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }
}