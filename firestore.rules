rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin.
    // In a real app, this should check for a custom claim.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@fgluxury.com';
    }
    
    // Bookings collection
    // - Allow anyone to create (submit a booking request).
    // - Allow only admins to read, update (confirm), or delete bookings.
    match /bookings/{bookingId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }
  }
}
