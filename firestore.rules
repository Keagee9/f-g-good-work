/**
 * @fileoverview Firestore Security Rules for AcuClone.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for appointments, 
 * and public read-only access for services and suggested styles.
 *
 * Data Structure:
 * - /services/{serviceId}: Publicly readable service listings.
 * - /users/{userId}/appointments/{appointmentId}: Appointments owned by a specific user.
 * - /suggestedStyles/{suggestedStyleId}: Publicly readable suggested braid styles.
 *
 * Key Security Decisions:
 * - Users can only access their own appointments.
 * - Services and suggested styles are publicly readable.
 * - Data schema validation is relaxed to allow for rapid prototyping. Only ownership and relationship fields are validated.
 * - All write operations require authentication.
 *
 * Denormalization for Authorization:
 * - The 'appointments' subcollection under `/users/{userId}` uses path-based ownership for simple and performant rules.
 *
 * Structural Segregation:
 * - Public data (services, suggested styles) is stored in top-level collections, while private user data (appointments) is stored in user-specific subcollections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants public read access to service listings. Only authenticated users can create, update, or delete services.
     * @path /services/{serviceId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn();
     * @allow delete: if isSignedIn();
     * @deny create: if !isSignedIn();
     * @deny update: if !isSignedIn();
     * @deny delete: if !isSignedIn();
     * @principle Allows public reads, restricts writes to signed in users.
     */
    match /services/{serviceId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Enforces user-ownership for appointments. Users can only access their own appointments.
     * @path /users/{userId}/appointments/{appointmentId}
     * @allow get, list: if isOwner(userId);
     * @allow create: if isOwner(userId);
     * @allow update: if isExistingOwner(userId);
     * @allow delete: if isExistingOwner(userId);
     * @deny get: if !isOwner(userId);
     * @deny list: if !isOwner(userId);
     * @deny create: if !isOwner(userId);
     * @deny update: if !isExistingOwner(userId);
     * @deny delete: if !isExistingOwner(userId);
     * @principle Enforces document ownership for all operations within a user's data tree.
     */
    match /users/{userId}/appointments/{appointmentId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Grants public read access to suggested braid styles. Only authenticated users can create, update, or delete styles.
     * @path /suggestedStyles/{suggestedStyleId}
     * @allow get, list: if true;
     * @allow create: if isSignedIn();
     * @allow update: if isSignedIn();
     * @allow delete: if isSignedIn();
     * @deny create: if !isSignedIn();
     * @deny update: if !isSignedIn();
     * @deny delete: if !isSignedIn();
     * @principle Allows public reads, restricts writes to signed in users.
     */
    match /suggestedStyles/{suggestedStyleId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}