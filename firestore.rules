/**
 * @description This ruleset enforces a strict user-ownership model for appointments and allows public read access to services and suggested styles.
 *
 * Data Structure:
 * - /services/{serviceId}: Stores service details, publicly readable.
 * - /users/{userId}/appointments/{appointmentId}: Stores appointments, accessible only by the owning user.
 * - /suggestedStyles/{suggestedStyleId}: Stores suggested styles, publicly readable.
 *
 * Key Security Decisions:
 * - User listing is implicitly disallowed via the design, as there is no top-level collection of users.
 * - Services and suggested styles are publicly readable but not writable by clients. This assumes an external process manages these collections.
 * - Appointments are strictly owned by the user; only the user can create, read, update, or delete their own appointments.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to service details. Write access is denied.
     * @path /services/{serviceId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows anyone to read service details, but prevents unauthorized modifications.
     */
    match /services/{serviceId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Enforces user-ownership for appointments. Only the user can create, read, update, or delete their own appointments.
     * @path /users/{userId}/appointments/{appointmentId}
     * @allow (create) User A can create an appointment under /users/A/appointments/{appointmentId} if authenticated as User A.
     * @allow (get, list, update, delete) User A can get, list, update, or delete their own appointments under /users/A/appointments/{appointmentId} if authenticated as User A.
     * @deny (create) User B cannot create an appointment under /users/A/appointments/{appointmentId} if authenticated as User B.
     * @deny (get, list, update, delete) User B cannot get, list, update, or delete appointments under /users/A/appointments/{appointmentId} if authenticated as User B.
     * @principle Enforces document ownership for all operations. Validates path-based ownership.
     */
    match /users/{userId}/appointments/{appointmentId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == appointmentId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to suggested braid styles. Write access is denied.
     * @path /suggestedStyles/{suggestedStyleId}
     * @allow (get, list)
     * @deny (create, update, delete)
     * @principle Allows anyone to read suggested style details, but prevents unauthorized modifications.
     */
    match /suggestedStyles/{suggestedStyleId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
    }
  }
}