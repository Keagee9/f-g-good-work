/**
 * @file Firestore Security Rules
 * @description This ruleset is designed for the braider booking application.
 *
 * Core Philosophy:
 *   This ruleset prioritizes security and data ownership.  It enforces a mix of
 *   public read access with owner-only write access for some collections (e.g., /bookings),
 *   and strict user-ownership for user-specific data (e.g., /users/{userId}/appointments).
 *
 * Data Structure:
 *   - /bookings/{bookingId}: Stores booking requests. Publicly readable, but only
 *     creatable by authenticated users.
 *   - /services/{serviceId}: Stores service details. Publicly readable.
 *   - /users/{userId}/appointments/{appointmentId}: Stores user-specific appointment data.
 *   - /suggestedStyles/{suggestedStyleId}: Public collection of braid styles.
 *
 * Key Security Decisions:
 *   - No user listing is allowed.
 *   - Users can only create bookings.
 *   - Users can only manage their own appointments under their respective /users/{userId} path.
 *   - All other write operations are disallowed unless explicitly granted.
 *
 * Denormalization for Authorization:
 *   - The current data model does not require denormalization.  The security rules can directly
 *     enforce access controls based on the path and, where necessary, checking the data being written
 *     (e.g., ensuring the authorId field in a /bookings document matches the request.auth.uid).
 *
 * Structural Segregation:
 *   - Private user data (appointments) is stored under the /users/{userId} subcollection.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows anyone to read booking details, but only authenticated users can create new bookings.
     *   Updates and deletes are disallowed for now.
     * @path /bookings/{bookingId}
     * @allow (get, list): if true;
     * @allow (create): if isSignedIn();
     * @deny (update, delete): if true;
     * @principle Allows public reads and authenticated writes for booking requests.
     */
    match /bookings/{bookingId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    /**
     * @description Allows anyone to read service details.  Write access is disallowed for now.
     * @path /services/{serviceId}
     * @allow (get, list): if true;
     * @deny (create, update, delete): if true;
     * @principle Grants public read access to service information.
     */
    match /services/{serviceId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Allows a user to manage their own appointments.
     * @path /users/{userId}/appointments/{appointmentId}
     * @allow (get, list): if isOwner(userId);
     * @allow (create): if isOwner(userId);
     * @allow (update): if isExistingOwner(userId);
     * @allow (delete): if isExistingOwner(userId);
     * @deny any write request, if the user tries to change the `userId`.
     * @principle Enforces user-ownership for appointment data.
     */
    match /users/{userId}/appointments/{appointmentId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows anyone to read braid style suggestions. Write access is disallowed.
     * @path /suggestedStyles/{suggestedStyleId}
     * @allow (get, list): if true;
     * @deny (create, update, delete): if true;
     * @principle Grants public read access to suggested styles.
     */
    match /suggestedStyles/{suggestedStyleId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // ---- Helper functions ----

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user ID matches the provided user ID.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

     /**
      * @description Checks if the authenticated user ID matches the provided user ID and that the resource exists.
      *   This function should always be used for update and delete operations to prevent accidental changes to
      *   non-existent data.
      */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}