/**
 * @file Firestore Security Rules for AcuClone.
 *
 * @corePhilosophy
 * This ruleset enforces a combination of public read access for certain collections (e.g., services, suggestedStyles) and strict user-ownership for user-specific data (e.g., appointments).
 *
 * @dataStructure
 * - `/services/{serviceId}`: Stores publicly readable service data.
 * - `/users/{userId}/appointments/{appointmentId}`: Stores user-specific appointment data, accessible only to the owning user.
 * - `/suggestedStyles/{suggestedStyleId}`: Stores publicly readable suggested style data.
 *
 * @keySecurityDecisions
 * - Services and SuggestedStyles are publicly readable but updates and deletes are forbidden. The application is in prototyping, so create is also forbidden.
 * - User appointments are strictly owned and controlled by the user ID in the path.
 * - The rules do not enforce the specific schema for `services` and `suggestedStyles` to allow for rapid iteration. The rules do enforce data consistency for appointments.
 *
 * @denormalizationForAuthorization
 *  - N/A (Path-based ownership is used for appointments)
 *
 * @structuralSegregation
 * - Public data (services, suggestedStyles) is stored in top-level collections. Private user data (appointments) is stored in user-specific subcollections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows public read access to services, but restricts write access.
     * @path /services/{serviceId}
     * @allow (get, list) Anyone can read service data.
     * @deny (create, update, delete) No one can create, update, or delete service data through the rules.
     * @principle Public read, restricted writes.
     */
    match /services/{serviceId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Manages appointments for a specific user. Only the owning user can create, read, update, and delete their own appointments.
     * @path /users/{userId}/appointments/{appointmentId}
     * @allow (create) User 'user_abc' can create an appointment with ID 'appointment_123' under their user ID if request.auth.uid == 'user_abc'. The 'id' field in the appointment data must also equal 'appointment_123'.
     * @allow (get, list) User 'user_abc' can read their own appointment data.
     * @allow (update, delete) User 'user_abc' can update/delete their own existing appointment data.
     * @deny (create) User 'user_xyz' cannot create an appointment under 'user_abc'.
     * @deny (get, list) User 'user_xyz' cannot read appointments under 'user_abc'.
     * @deny (update, delete) User 'user_xyz' cannot update/delete appointments under 'user_abc'.
     * @principle Enforces document ownership for all operations. Validates relational integrity between path and document data on create and update.
     */
    match /users/{userId}/appointments/{appointmentId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == appointmentId;
      allow update: if isSignedIn() && isExistingOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to suggested styles, but restricts write access.
     * @path /suggestedStyles/{suggestedStyleId}
     * @allow (get, list) Anyone can read suggested style data.
     * @deny (create, update, delete) No one can create, update, or delete suggested style data.
     * @principle Public read, restricted writes.
     */
    match /suggestedStyles/{suggestedStyleId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
        return isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}