{
  "entities": {
    "Service": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Service",
      "type": "object",
      "description": "Represents a service offered, cloned from AcuityScheduling.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the service." },
        "name": { "type": "string", "description": "Name of the service." },
        "description": { "type": "string", "description": "Detailed description of the service." },
        "price": { "type": "number", "description": "Price of the service." },
        "imageUrl": { "type": "string", "description": "URL of the image representing the service.", "format": "uri" }
      },
      "required": ["id", "name", "description", "price"]
    },
    "Appointment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Appointment",
      "type": "object",
      "description": "Represents a scheduled appointment for a specific service.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the appointment." },
        "serviceId": { "type": "string", "description": "Reference to the Service. (Relationship: Service 1:N Appointment)" },
        "startTime": { "type": "string", "description": "The date and time the appointment starts.", "format": "date-time" },
        "endTime": { "type": "string", "description": "The date and time the appointment ends.", "format": "date-time" }
      },
      "required": ["id", "serviceId", "startTime", "endTime"]
    },
    "SuggestedStyle": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SuggestedStyle",
      "type": "object",
      "description": "Represents a braid style suggested by the GenAI tool.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the suggested style." },
        "styleName": { "type": "string", "description": "Name of the suggested braid style." },
        "styleDescription": { "type": "string", "description": "Description of the suggested style." },
        "imageUrl": { "type": "string", "description": "URL of the image representing the suggested style.", "format": "uri" }
      },
      "required": ["id", "styleName", "styleDescription", "imageUrl"]
    },
    "Booking": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Booking",
      "type": "object",
      "description": "Represents a client booking request, including payment proof.",
      "properties": {
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string", "format": "email" },
        "customerPhone": { "type": "string" },
        "serviceName": { "type": "string" },
        "date": { "type": "string" },
        "totalPrice": { "type": "number" },
        "addons": { "type": "array", "items": { "type": "string" } },
        "receiptDataUri": { "type": "string", "format": "uri" },
        "status": { "type": "string", "enum": ["pending", "confirmed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "customerName",
        "customerEmail",
        "customerPhone",
        "serviceName",
        "date",
        "totalPrice",
        "receiptDataUri",
        "status",
        "createdAt"
      ]
    }
  },
  "auth": {
    "providers": [ "password", "anonymous" ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/bookings/{bookingId}",
        "definition": {
          "entityName": "Booking",
          "schema": { "$ref": "#/backend/entities/Booking" },
          "description": "Stores all booking requests. Publicly readable for date checking, writable for new bookings, admin-only for updates/deletes.",
          "params": [ { "name": "bookingId", "description": "Unique identifier for the booking." } ]
        }
      },
      {
        "path": "/services/{serviceId}",
        "definition": {
          "entityName": "Service",
          "schema": { "$ref": "#/backend/entities/Service" },
          "description": "Stores service details. Each document represents a unique service.",
          "params": [ { "name": "serviceId", "description": "Unique identifier for the service." } ]
        }
      },
      {
        "path": "/users/{userId}/appointments/{appointmentId}",
        "definition": {
          "entityName": "Appointment",
          "schema": { "$ref": "#/backend/entities/Appointment" },
          "description": "Stores appointment details for a specific user. Each document represents a unique appointment. Path based ownership.",
          "params": [
            { "name": "userId", "description": "Unique identifier for the user." },
            { "name": "appointmentId", "description": "Unique identifier for the appointment." }
          ]
        }
      },
      {
        "path": "/suggestedStyles/{suggestedStyleId}",
        "definition": {
          "entityName": "SuggestedStyle",
          "schema": { "$ref": "#/backend/entities/SuggestedStyle" },
          "description": "Stores suggested braid styles from the GenAI tool.",
          "params": [ { "name": "suggestedStyleId", "description": "Unique identifier for the suggested style." } ]
        }
      }
    ]
  }
}
